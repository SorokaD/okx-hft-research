        "# ============================================================\n",
        "# 4. Target consistency / sanity checks\n",
        "# ============================================================\n",
        "parsed_binary = pd.DataFrame([parse_target_name(col) for col in BINARY_TARGET_COLUMNS])\n",
        "\n",
        "violations = []\n",
        "for direction in [\"long\", \"short\"]:\n",
        "    for horizon in sorted(parsed_binary[\"horizon_sec\"].dropna().unique()):\n",
        "        sub = parsed_binary[(parsed_binary[\"direction\"] == direction) & (parsed_binary[\"horizon_sec\"] == horizon)]\n",
        "        sub_sym = sub[sub[\"symmetric\"] == True].sort_values(\"threshold_ticks\")\n",
        "        thresholds = sub_sym[\"threshold_ticks\"].dropna().astype(int).tolist()\n",
        "        for t_small, t_big in zip(thresholds[:-1], thresholds[1:]):\n",
        "            c_small = sub_sym.loc[sub_sym[\"threshold_ticks\"] == t_small, \"target_name\"].iloc[0]\n",
        "            c_big = sub_sym.loc[sub_sym[\"threshold_ticks\"] == t_big, \"target_name\"].iloc[0]\n",
        "            s_small = pd.to_numeric(df[c_small], errors=\"coerce\")\n",
        "            s_big = pd.to_numeric(df[c_big], errors=\"coerce\")\n",
        "            bad = int(((s_big == 1) & (s_small != 1)).sum())\n",
        "            if bad > 0:\n",
        "                violations.append(\n",
        "                    {\n",
        "                        \"kind\": \"threshold_monotonicity_violation\",\n",
        "                        \"direction\": direction,\n",
        "                        \"horizon_sec\": horizon,\n",
        "                        \"lower_threshold\": t_small,\n",
        "                        \"higher_threshold\": t_big,\n",
        "                        \"lower_target\": c_small,\n",
        "                        \"higher_target\": c_big,\n",
        "                        \"violations\": bad,\n",
        "                    }\n",
        "                )\n",
        "\n",
        "for direction in [\"long\", \"short\"]:\n",
        "    sub = parsed_binary[(parsed_binary[\"direction\"] == direction) & (parsed_binary[\"symmetric\"] == True)]\n",
        "    for threshold in sorted(sub[\"threshold_ticks\"].dropna().unique()):\n",
        "        sub_thr = sub[sub[\"threshold_ticks\"] == threshold].sort_values(\"horizon_sec\")\n",
        "        horizons = sub_thr[\"horizon_sec\"].dropna().astype(int).tolist()\n",
        "        for h_small, h_big in zip(horizons[:-1], horizons[1:]):\n",
        "            c_small = sub_thr.loc[sub_thr[\"horizon_sec\"] == h_small, \"target_name\"].iloc[0]\n",
        "            c_big = sub_thr.loc[sub_thr[\"horizon_sec\"] == h_big, \"target_name\"].iloc[0]\n",
        "            s_small = pd.to_numeric(df[c_small], errors=\"coerce\")\n",
        "            s_big = pd.to_numeric(df[c_big], errors=\"coerce\")\n",
        "            bad = int(((s_small == 1) & (s_big != 1)).sum())\n",
        "            if bad > 0:\n",
        "                violations.append(\n",
        "                    {\n",
        "                        \"kind\": \"horizon_monotonicity_violation\",\n",
        "                        \"direction\": direction,\n",
        "                        \"threshold_ticks\": threshold,\n",
        "                        \"smaller_horizon\": h_small,\n",
        "                        \"larger_horizon\": h_big,\n",
        "                        \"smaller_target\": c_small,\n",
        "                        \"larger_target\": c_big,\n",
        "                        \"violations\": bad,\n",
        "                    }\n",
        "                )\n",
        "\n",
        "violations_df = pd.DataFrame(violations)\n",
        "display(violations_df.head(100))\n",
        "\n",
        "trend_anomalies = []\n",
        "for direction in [\"long\", \"short\"]:\n",
        "    sub = rate_df[(rate_df[\"direction\"] == direction) & (rate_df[\"symmetric\"] == True)]\n",
        "    for horizon in sorted(sub[\"horizon_sec\"].dropna().unique()):\n",
        "        ssub = sub[sub[\"horizon_sec\"] == horizon].sort_values(\"threshold_ticks\")\n",
        "        vals = ssub[\"positive_rate_pct\"].to_numpy()\n",
        "        thr = ssub[\"threshold_ticks\"].to_numpy()\n",
        "        for i in range(1, len(vals)):\n",
        "            if vals[i] > vals[i - 1] + 1e-9:\n",
        "                trend_anomalies.append(\n",
        "                    {\n",
        "                        \"kind\": \"rate_increases_with_threshold\",\n",
        "                        \"direction\": direction,\n",
        "                        \"horizon_sec\": horizon,\n",
        "                        \"prev_threshold\": thr[i - 1],\n",
        "                        \"curr_threshold\": thr[i],\n",
        "                        \"prev_rate\": vals[i - 1],\n",
        "                        \"curr_rate\": vals[i],\n",
        "                    }\n",
        "                )\n",
        "    for threshold in sorted(sub[\"threshold_ticks\"].dropna().unique()):\n",
        "        ssub = sub[sub[\"threshold_ticks\"] == threshold].sort_values(\"horizon_sec\")\n",
        "        vals = ssub[\"positive_rate_pct\"].to_numpy()\n",
        "        hrs = ssub[\"horizon_sec\"].to_numpy()\n",
        "        for i in range(1, len(vals)):\n",
        "            if vals[i] + 1e-9 < vals[i - 1]:\n",
        "                trend_anomalies.append(\n",
        "                    {\n",
        "                        \"kind\": \"rate_decreases_with_horizon\",\n",
        "                        \"direction\": direction,\n",
        "                        \"threshold_ticks\": threshold,\n",
        "                        \"prev_horizon\": hrs[i - 1],\n",
        "                        \"curr_horizon\": hrs[i],\n",
        "                        \"prev_rate\": vals[i - 1],\n",
        "                        \"curr_rate\": vals[i],\n",
        "                    }\n",
        "                )\n",
        "\n",
        "trend_anomalies_df = pd.DataFrame(trend_anomalies)\n",
        "display(trend_anomalies_df.head(100))\n",
        "print(\"Если таблицы выше пустые или почти пустые, target logic выглядит согласованной.\")\n"
      ]
    },
