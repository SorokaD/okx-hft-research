        "# ============================================================\n",
        "# Helper functions\n",
        "# ============================================================\n",
        "BINARY_TARGET_PATTERNS = [\n",
        "    re.compile(r\"^(long|short)_hit_.*_within_(\\d+)s$\"),\n",
        "]\n",
        "REG_TARGET_PATTERNS = [\n",
        "    re.compile(r\"^(long|short)_max_(favorable|adverse)_excursion_ticks_within_(\\d+)s$\"),\n",
        "]\n",
        "\n",
        "\n",
        "def detect_target_columns(columns: list[str]) -> dict[str, list[str]]:\n",
        "    binary_targets = []\n",
        "    regression_targets = []\n",
        "    for col in columns:\n",
        "        if any(p.match(col) for p in BINARY_TARGET_PATTERNS):\n",
        "            binary_targets.append(col)\n",
        "        elif any(p.match(col) for p in REG_TARGET_PATTERNS):\n",
        "            regression_targets.append(col)\n",
        "    target_columns = sorted(set(binary_targets + regression_targets))\n",
        "    feature_columns = [\n",
        "        col\n",
        "        for col in columns\n",
        "        if col not in target_columns and col not in {\"ts_event\", \"inst_id\", \"anchor_snapshot_ts\", \"reconstruction_mode\"}\n",
        "    ]\n",
        "    return {\n",
        "        \"target_columns\": target_columns,\n",
        "        \"binary_target_columns\": sorted(binary_targets),\n",
        "        \"regression_target_columns\": sorted(regression_targets),\n",
        "        \"feature_columns\": feature_columns,\n",
        "    }\n",
        "\n",
        "\n",
        "import importlib\n",
        "import sys\n",
        "\n",
        "if str(ROOT) not in sys.path:\n",
        "    sys.path.insert(0, str(ROOT))\n",
        "import research.utils.target_columns as _parse_target_mod\n",
        "importlib.reload(_parse_target_mod)\n",
        "parse_target_name = _parse_target_mod.parse_target_name\n",
        "binary_target_is_modeling_eligible = _parse_target_mod.binary_target_is_modeling_eligible\n",
        "\n",
        "\n",
        "def summarize_dataset(df: pd.DataFrame) -> pd.DataFrame:\n",
        "    info = detect_target_columns(df.columns.tolist())\n",
        "    summary = pd.DataFrame(\n",
        "        {\n",
        "            \"metric\": [\n",
        "                \"n_rows\",\n",
        "                \"n_columns\",\n",
        "                \"n_feature_columns\",\n",
        "                \"n_target_columns\",\n",
        "                \"n_binary_targets\",\n",
        "                \"n_regression_targets\",\n",
        "                \"ts_min\",\n",
        "                \"ts_max\",\n",
        "                \"total_nan_cells\",\n",
        "            ],\n",
        "            \"value\": [\n",
        "                int(len(df)),\n",
        "                int(df.shape[1]),\n",
        "                int(len(info[\"feature_columns\"])),\n",
        "                int(len(info[\"target_columns\"])),\n",
        "                int(len(info[\"binary_target_columns\"])),\n",
        "                int(len(info[\"regression_target_columns\"])),\n",
        "                str(df[\"ts_event\"].min()) if \"ts_event\" in df.columns else None,\n",
        "                str(df[\"ts_event\"].max()) if \"ts_event\" in df.columns else None,\n",
        "                int(df.isna().sum().sum()),\n",
        "            ],\n",
        "        }\n",
        "    )\n",
        "    return summary\n",
        "\n",
        "\n",
        "def positive_rate_table(df: pd.DataFrame, binary_targets: list[str]) -> pd.DataFrame:\n",
        "    rows = []\n",
        "    for col in binary_targets:\n",
        "        s = pd.to_numeric(df[col], errors=\"coerce\")\n",
        "        positives = int((s == 1).sum())\n",
        "        negatives = int((s == 0).sum())\n",
        "        valid = positives + negatives\n",
        "        rate = 100.0 * positives / valid if valid > 0 else np.nan\n",
        "        meta = parse_target_name(col)\n",
        "        rows.append(\n",
        "            {\n",
        "                \"target_name\": col,\n",
        "                \"positives\": positives,\n",
        "                \"negatives\": negatives,\n",
        "                \"positive_rate_pct\": rate,\n",
        "                **meta,\n",
        "            }\n",
        "        )\n",
        "    out = pd.DataFrame(rows).sort_values(\"positive_rate_pct\")\n",
        "    out[\"target_quality\"] = np.where(\n",
        "        out[\"positive_rate_pct\"].between(2.0, 40.0, inclusive=\"both\"),\n",
        "        \"usable\",\n",
        "        \"bad\",\n",
        "    )\n",
        "    return out.reset_index(drop=True)\n",
        "\n",
        "\n",
        "def plot_target_heatmap(rate_df: pd.DataFrame, *, direction: str, symmetric: object, title: str):\n",
        "    sub = rate_df[(rate_df[\"direction\"] == direction)].copy()\n",
        "    if symmetric is True:\n",
        "        sub = sub[sub[\"symmetric\"] == True]\n",
        "    elif symmetric is False:\n",
        "        sub = sub[sub[\"symmetric\"] == False]\n",
        "    sub = sub.dropna(subset=[\"threshold_ticks\", \"horizon_sec\"])\n",
        "    if sub.empty:\n",
        "        print(f\"Нет данных для heatmap: {title}\")\n",
        "        return None\n",
        "    pivot = sub.pivot_table(\n",
        "        index=\"horizon_sec\",\n",
        "        columns=\"threshold_ticks\",\n",
        "        values=\"positive_rate_pct\",\n",
        "        aggfunc=\"mean\",\n",
        "    ).sort_index().sort_index(axis=1)\n",
        "    fig, ax = plt.subplots(figsize=(10, 5))\n",
        "    sns.heatmap(pivot, annot=True, fmt=\".2f\", cmap=\"viridis\", ax=ax)\n",
        "    ax.set_title(title)\n",
        "    ax.set_xlabel(\"threshold_ticks\")\n",
        "    ax.set_ylabel(\"horizon_sec\")\n",
        "    plt.tight_layout()\n",
        "    return fig\n",
        "\n",
        "\n",
        "def choose_candidate_targets(rate_df: pd.DataFrame) -> list[str]:\n",
        "    preferred = [\n",
        "        \"long_hit_up_260t_before_down_120t_within_180s\",\n",
        "        \"short_hit_down_260t_before_up_120t_within_180s\",\n",
        "    ]\n",
        "    available = [t for t in preferred if t in rate_df[\"target_name\"].tolist()]\n",
        "    if available:\n",
        "        return available\n",
        "    usable = rate_df[rate_df[\"target_quality\"] == \"usable\"].copy()\n",
        "    usable = usable.sort_values([\"positive_rate_pct\", \"horizon_sec\"], ascending=[False, True])\n",
        "    return usable[\"target_name\"].head(3).tolist()\n",
        "\n",
        "\n",
        "def compare_feature_distributions(\n",
        "    df: pd.DataFrame,\n",
        "    *,\n",
        "    feature_columns: list[str],\n",
        "    target_col: str,\n",
        "    top_n: int = 20,\n",
        ") -> pd.DataFrame:\n",
        "    y = pd.to_numeric(df[target_col], errors=\"coerce\")\n",
        "    rows = []\n",
        "    for feature in feature_columns:\n",
        "        x = pd.to_numeric(df[feature], errors=\"coerce\")\n",
        "        mask = x.notna() & y.isin([0, 1])\n",
        "        if mask.sum() < 500:\n",
        "            continue\n",
        "        pos = x[mask & (y == 1)]\n",
        "        neg = x[mask & (y == 0)]\n",
        "        if len(pos) < 50 or len(neg) < 50:\n",
        "            continue\n",
        "        ks = ks_2samp(pos, neg)\n",
        "        pooled_std = np.nanstd(pd.concat([pos, neg], axis=0), ddof=1)\n",
        "        delta = pos.mean() - neg.mean()\n",
        "        effect = delta / pooled_std if pooled_std and np.isfinite(pooled_std) and pooled_std > 0 else np.nan\n",
        "        rows.append(\n",
        "            {\n",
        "                \"feature\": feature,\n",
        "                \"target\": target_col,\n",
        "                \"mean_positive\": pos.mean(),\n",
        "                \"mean_negative\": neg.mean(),\n",
        "                \"std_positive\": pos.std(),\n",
        "                \"std_negative\": neg.std(),\n",
        "                \"median_positive\": pos.median(),\n",
        "                \"median_negative\": neg.median(),\n",
        "                \"p10_positive\": pos.quantile(0.10),\n",
        "                \"p10_negative\": neg.quantile(0.10),\n",
        "                \"p90_positive\": pos.quantile(0.90),\n",
        "                \"p90_negative\": neg.quantile(0.90),\n",
        "                \"delta\": delta,\n",
        "                \"effect_size\": effect,\n",
        "                \"ks_stat\": ks.statistic,\n",
        "                \"ks_pvalue\": ks.pvalue,\n",
        "            }\n",
        "        )\n",
        "    result = pd.DataFrame(rows)\n",
        "    if result.empty:\n",
        "        return result\n",
        "    return result.sort_values([\"effect_size\", \"ks_stat\"], ascending=[False, False]).head(top_n)\n",
        "\n",
        "\n",
        "def is_raw_instrument_price_feature(col: str) -> bool:\n",
        "    if col in MODEL_EXCLUDE_RAW_PRICE_FEATURES:\n",
        "        return True\n",
        "    if col.endswith(\"_px\") and \"return\" not in col and \"velocity\" not in col:\n",
        "        return True\n",
        "    return False\n",
        "\n",
        "\n",
        "def exclude_raw_price_features(cols: list[str]) -> list[str]:\n",
        "    return [c for c in cols if not is_raw_instrument_price_feature(c)]\n",
        "\n",
        "\n",
        "def choose_model_features(feature_columns: list[str]) -> list[str]:\n",
        "    feature_columns = exclude_raw_price_features(list(feature_columns))\n",
        "    priority = [\n",
        "        \"imbalance_1\",\n",
        "        \"imbalance_5\",\n",
        "        \"imbalance_10\",\n",
        "        \"spread_ticks\",\n",
        "        \"relative_spread\",\n",
        "        \"realized_vol_10s\",\n",
        "        \"realized_vol_30s\",\n",
        "        \"realized_vol_300s\",\n",
        "        \"realized_vol_3600s\",\n",
        "        \"mid_return_300s\",\n",
        "        \"mid_return_3600s\",\n",
        "        \"order_flow_imbalance_300s\",\n",
        "        \"order_flow_imbalance_3600s\",\n",
        "        \"update_intensity_300s\",\n",
        "        \"update_intensity_3600s\",\n",
        "        \"order_flow_imbalance_1s\",\n",
        "        \"order_flow_imbalance_5s\",\n",
        "        \"update_intensity_1s\",\n",
        "        \"update_intensity_5s\",\n",
        "        \"mid_return_1s\",\n",
        "        \"mid_return_3s\",\n",
        "        \"mid_return_5s\",\n",
        "        \"imbalance_1_delta_1s\",\n",
        "        \"imbalance_5_delta_1s\",\n",
        "        \"imbalance_10_delta_5s\",\n",
        "    ]\n",
        "    ordered = [col for col in priority if col in feature_columns]\n",
        "    fallback = [col for col in feature_columns if col not in ordered]\n",
        "    return (ordered + fallback)[:MAX_MODEL_FEATURES]\n",
        "\n",
        "\n",
        "def run_baseline_model(\n",
        "    df: pd.DataFrame,\n",
        "    *,\n",
        "    target_col: str,\n",
        "    feature_columns: list[str],\n",
        ") -> tuple[pd.DataFrame, dict[str, object]]:\n",
        "    feature_columns = exclude_raw_price_features(list(feature_columns))\n",
        "    if not feature_columns:\n",
        "        return pd.DataFrame(), {}\n",
        "    y = pd.to_numeric(df[target_col], errors=\"coerce\")\n",
        "    X = df[feature_columns].copy()\n",
        "    mask = y.isin([0, 1])\n",
        "    X = X.loc[mask]\n",
        "    y = y.loc[mask].astype(int)\n",
        "    if len(X) < 1000:\n",
        "        return pd.DataFrame(), {}\n",
        "\n",
        "    # keep the same time-based split (no shuffle)\n",
        "    split_idx = int(len(X) * 0.7)\n",
        "    X_train, X_test = X.iloc[:split_idx], X.iloc[split_idx:]\n",
        "    y_train, y_test = y.iloc[:split_idx], y.iloc[split_idx:]\n",
        "    if y_train.nunique() < 2 or y_test.nunique() < 2:\n",
        "        return pd.DataFrame(), {}\n",
        "\n",
        "    rows = []\n",
        "\n",
        "    # 1) Logistic regression baseline (same split/features/prep)\n",
        "    logreg = Pipeline(\n",
        "        [\n",
        "            (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
        "            (\"scaler\", StandardScaler()),\n",
        "            (\"model\", LogisticRegression(max_iter=300, random_state=RANDOM_SEED)),\n",
        "        ]\n",
        "    )\n",
        "    logreg.fit(X_train, y_train)\n",
        "    proba = logreg.predict_proba(X_test)[:, 1]\n",
        "    pred = (proba >= 0.5).astype(int)\n",
        "    rows.append(\n",
        "        {\n",
        "            \"target\": target_col,\n",
        "            \"model\": \"logreg\",\n",
        "            \"roc_auc\": roc_auc_score(y_test, proba),\n",
        "            \"pr_auc\": average_precision_score(y_test, proba),\n",
        "            \"accuracy\": accuracy_score(y_test, pred),\n",
        "            \"precision\": precision_score(y_test, pred, zero_division=0),\n",
        "            \"recall\": recall_score(y_test, pred, zero_division=0),\n",
        "            \"f1\": f1_score(y_test, pred, zero_division=0),\n",
        "            \"positive_rate\": float(y_test.mean()),\n",
        "            \"n_train\": int(len(X_train)),\n",
        "            \"n_test\": int(len(X_test)),\n",
        "        }\n",
        "    )\n",
        "\n",
        "    # 2) CatBoost for every target: class_weights + early stopping\n",
        "    from catboost import CatBoostClassifier\n",
        "\n",
        "    n_pos = int((y_train == 1).sum())\n",
        "    n_neg = int((y_train == 0).sum())\n",
        "    if n_pos <= 0 or n_neg <= 0:\n",
        "        return pd.DataFrame(rows), {}\n",
        "    weight_0 = 1.0\n",
        "    weight_1 = float(n_neg / n_pos)\n",
        "\n",
        "    cat_params = {\n",
        "        \"loss_function\": \"Logloss\",\n",
        "        \"eval_metric\": \"PRAUC\",\n",
        "        \"iterations\": 1200,\n",
        "        \"learning_rate\": 0.03,\n",
        "        \"depth\": 5,\n",
        "        \"l2_leaf_reg\": 10,\n",
        "        \"subsample\": 0.8,\n",
        "        \"random_strength\": 1.0,\n",
        "        \"bootstrap_type\": \"Bernoulli\",\n",
        "        \"min_data_in_leaf\": 100,\n",
        "        \"leaf_estimation_iterations\": 5,\n",
        "        \"grow_policy\": \"SymmetricTree\",\n",
        "        \"verbose\": 100,\n",
        "        \"random_seed\": 42,\n",
        "        \"allow_writing_files\": False,\n",
        "        \"thread_count\": -1,\n",
        "        \"class_weights\": [weight_0, weight_1],\n",
        "    }\n",
        "\n",
        "    # keep the same preparation logic: median imputation\n",
        "    imputer = SimpleImputer(strategy=\"median\")\n",
        "    X_train_imp = imputer.fit_transform(X_train)\n",
        "    X_test_imp = imputer.transform(X_test)\n",
        "\n",
        "    if cat_params.get(\"bootstrap_type\") != \"Bayesian\":\n",`r`n        "        cat_params.pop(\"bagging_temperature\", None)\n",`r`n        "    if cat_params.get(""bootstrap_type"") != ""Bayesian"":\n",`r`n        "        cat_params.pop(""bagging_temperature"", None)\n",`r`n        "    cat = CatBoostClassifier(**cat_params)\n",
        "    cat.fit(\n",
        "        X_train_imp,\n",
        "        y_train,\n",
        "        eval_set=(X_test_imp, y_test),\n",
        "        use_best_model=True,\n",
        "        early_stopping_rounds=100,\n",
        "    )\n",
        "\n",
        "    proba = cat.predict_proba(X_test_imp)[:, 1]\n",
        "    pred = (proba >= 0.5).astype(int)\n",
        "    try:\n",
        "        best_iter = int(cat.get_best_iteration())\n",
        "    except Exception:\n",
        "        best_iter = -1\n",
        "\n",
        "    rows.append(\n",
        "        {\n",
        "            \"target\": target_col,\n",
        "            \"model\": \"catboost\",\n",
        "            \"roc_auc\": roc_auc_score(y_test, proba),\n",
        "            \"pr_auc\": average_precision_score(y_test, proba),\n",
        "            \"accuracy\": accuracy_score(y_test, pred),\n",
        "            \"precision\": precision_score(y_test, pred, zero_division=0),\n",
        "            \"recall\": recall_score(y_test, pred, zero_division=0),\n",
        "            \"f1\": f1_score(y_test, pred, zero_division=0),\n",
        "            \"positive_rate\": float(y_test.mean()),\n",
        "            \"n_train\": int(len(X_train)),\n",
        "            \"n_test\": int(len(X_test)),\n",
        "            \"weight_1\": weight_1,\n",
        "            \"best_iteration\": best_iter,\n",
        "        }\n",
        "    )\n",
        "\n",
        "    model_info = {\n",
        "        \"model_name\": \"catboost\",\n",
        "        \"model\": cat,\n",
        "        \"imputer\": imputer,\n",
        "        \"feature_columns\": feature_columns,\n",
        "        \"X_train\": X_train,\n",
        "        \"y_train\": y_train,\n",
        "    }\n",
        "\n",
        "    return pd.DataFrame(rows), model_info\n"
      ]
    },
