      "source": [
        "# ============================================================\n",
        "# 2. Проверка target imbalance\n",
        "# ============================================================\n",
        "rate_df = positive_rate_table(df, BINARY_TARGET_COLUMNS)\n",
        "BINARY_TARGETS_FOR_MODELING = [\n",
        "    c\n",
        "    for c in BINARY_TARGET_COLUMNS\n",
        "    if binary_target_is_modeling_eligible(c, min_favorable_ticks=MODEL_MIN_FAVORABLE_TICKS)\n",
        "]\n",
        "rate_df_model = positive_rate_table(df, BINARY_TARGETS_FOR_MODELING)\n",
        "print(\n",
        "    f\"Binary targets for modeling (favorable_ticks>={MODEL_MIN_FAVORABLE_TICKS}): \"\n",
        "    f\"{len(BINARY_TARGETS_FOR_MODELING)} of {len(BINARY_TARGET_COLUMNS)}\"\n",
        ")\n",
        "display(rate_df.head(50))\n",
        "display(rate_df[\"target_quality\"].value_counts(dropna=False).rename_axis(\"quality\").reset_index(name=\"count\"))\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(14, max(6, len(rate_df) * 0.22)))\n",
        "plot_df = rate_df.sort_values(\"positive_rate_pct\")\n",
        "sns.barplot(data=plot_df, x=\"positive_rate_pct\", y=\"target_name\", hue=\"target_quality\", dodge=False, ax=ax)\n",
        "ax.axvline(1.0, color=\"crimson\", ls=\"--\", label=\"too rare <1%\")\n",
        "ax.axvline(2.0, color=\"darkorange\", ls=\":\", label=\"usable lower 2%\")\n",
        "ax.axvline(40.0, color=\"darkgreen\", ls=\":\", label=\"usable upper 40%\")\n",
        "ax.axvline(80.0, color=\"purple\", ls=\"--\", label=\"too frequent >80%\")\n",
        "ax.set_title(\"Positive rate по всем бинарным target'ам\")\n",
        "ax.set_xlabel(\"positive_rate_pct\")\n",
        "ax.set_ylabel(\"target_name\")\n",
        "ax.legend(loc=\"lower right\")\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "for horizon in sorted(rate_df[\"horizon_sec\"].dropna().unique()):\n",
        "    sub = rate_df[rate_df[\"horizon_sec\"] == horizon].sort_values(\"positive_rate_pct\")\n",
        "    if sub.empty:\n",
        "        continue\n",
        "    fig, ax = plt.subplots(figsize=(12, max(4, len(sub) * 0.25)))\n",
        "    sns.barplot(data=sub, x=\"positive_rate_pct\", y=\"target_name\", hue=\"target_quality\", dodge=False, ax=ax)\n",
        "    ax.set_title(f\"Positive rate по target'ам для horizon={int(horizon)}s\")\n",
        "    ax.set_xlabel(\"positive_rate_pct\")\n",
        "    ax.set_ylabel(\"target_name\")\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "usable_targets = rate_df.loc[rate_df[\"target_quality\"] == \"usable\", \"target_name\"].tolist()\n",
        "bad_targets = rate_df.loc[rate_df[\"target_quality\"] == \"bad\", \"target_name\"].tolist()\n",
        "print(\"usable targets:\", len(usable_targets))\n",
        "print(\"bad targets:\", len(bad_targets))\n"
      ]
    },
