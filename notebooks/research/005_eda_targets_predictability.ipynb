      "source": [
        "## 1. Load dataset\n",
        "\n",
        "Читаем parquet **порциями по row groups** (PyArrow) и приводим `float64` → `float32`, чтобы не раздувать RAM. Полный merged-файл всё равно тяжёлый: при нехватке памяти в конфиге задайте `PARQUET_LOAD_MAX_ROWS` (например `2_000_000`).\n",
        "\n",
        "Далее при необходимости отрезаем строки без полного 3600 с lookback (`LOOKBACK_TRIM_COLUMN`), затем автодетект target / feature columns.\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "6b95b2a0",
      "metadata": {},
      "outputs": [],
      "source": [
        "# ============================================================\n",
        "# 1. Load dataset (row-group streaming + float64→float32)\n",
        "# ============================================================\n",
        "import gc\n",
        "\n",
        "import pyarrow as pa\n",
        "import pyarrow.compute as pc\n",
        "import pyarrow.parquet as pq\n",
        "\n",
        "\n",
        "def _table_downcast_float64_to_float32(table: pa.Table) -> pa.Table:\n",
        "    arrs = []\n",
        "    for i in range(table.num_columns):\n",
        "        col = table.column(i)\n",
        "        if col.type == pa.float64():\n",
        "            arrs.append(pc.cast(col, pa.float32()))\n",
        "        else:\n",
        "            arrs.append(col)\n",
        "    return pa.Table.from_arrays(arrs, names=table.column_names)\n",
        "\n",
        "\n",
        "def load_wide_merged_parquet(path: Path, *, max_rows: int | None = None) -> pd.DataFrame:\n",
        "    \"\"\"Load wide merged parquet using Arrow concat to avoid pandas block consolidation OOM.\"\"\"\n",
        "\n",
        "    pf = pq.ParquetFile(path)\n",
        "    tables: list[pa.Table] = []\n",
        "    total = 0\n",
        "    for rg in range(pf.num_row_groups):\n",
        "        if max_rows is not None:\n",
        "            need = max_rows - total\n",
        "            if need <= 0:\n",
        "                break\n",
        "\n",
        "        sub = pf.read_row_group(rg)\n",
        "        sub = _table_downcast_float64_to_float32(sub)\n",
        "\n",
        "        if max_rows is not None:\n",
        "            need = max_rows - total\n",
        "            if sub.num_rows > need:\n",
        "                sub = sub.slice(0, need)\n",
        "\n",
        "        total += sub.num_rows\n",
        "        tables.append(sub)\n",
        "\n",
        "        if max_rows is not None and total >= max_rows:\n",
        "            break\n",
        "\n",
        "    if not tables:\n",
        "        return pd.DataFrame()\n",
        "\n",
        "    try:\n",
        "        big = pa.concat_tables(tables, promote_options=\"default\")\n",
        "    except TypeError:\n",
        "        big = pa.concat_tables(tables)\n",
        "\n",
        "    del tables\n",
        "    gc.collect()\n",
        "\n",
        "    to_pandas_kwargs: dict[str, object] = {\"types_mapper\": pd.ArrowDtype}\n",
        "    try:\n",
        "        df_local = big.to_pandas(self_destruct=True, **to_pandas_kwargs)\n",
        "    except TypeError:\n",
        "        df_local = big.to_pandas(**to_pandas_kwargs)\n",
        "\n",
        "    del big\n",
        "    gc.collect()\n",
        "    return df_local\n",
        "\n",
        "\n",
        "df = load_wide_merged_parquet(DATA_PATH, max_rows=PARQUET_LOAD_MAX_ROWS)\n",
        "print(\n",
        "    f\"Loaded rows: {len(df):,}\"\n",
        "    + (\n",
        "        f\" (PARQUET_LOAD_MAX_ROWS={PARQUET_LOAD_MAX_ROWS})\"\n",
        "        if PARQUET_LOAD_MAX_ROWS is not None\n",
        "        else \" (full file)\"\n",
        "    )\n",
        ")\n",
        "if \"ts_event\" in df.columns:\n",
        "    df[\"ts_event\"] = pd.to_datetime(df[\"ts_event\"], utc=True, errors=\"coerce\")\n",
        "    df = df.sort_values(\"ts_event\").reset_index(drop=True)\n",
        "\n",
        "_n_before = len(df)\n",
        "if LOOKBACK_TRIM_COLUMN in df.columns:\n",
        "    df = df[df[LOOKBACK_TRIM_COLUMN].notna()].reset_index(drop=True)\n",
        "    print(\n",
        "        f\"Trimmed {_n_before - len(df)} rows without {LOOKBACK_TRIM_COLUMN} (full 3600s clock lookback)\"\n",
        "    )\n",
        "else:\n",
        "    print(f\"Note: {LOOKBACK_TRIM_COLUMN} not in columns; skip lookback trim\")\n",
        "\n",
        "detected = detect_target_columns(df.columns.tolist())\n",
        "TARGET_COLUMNS = detected[\"target_columns\"]\n",
        "FEATURE_COLUMNS = detected[\"feature_columns\"]\n",
        "BINARY_TARGET_COLUMNS = detected[\"binary_target_columns\"]\n",
        "REGRESSION_TARGET_COLUMNS = detected[\"regression_target_columns\"]\n",
        "\n",
        "dataset_summary = summarize_dataset(df)\n",
        "display(dataset_summary)\n",
        "print(\"shape:\", df.shape)\n",
        "print(\"all columns:\", len(df.columns))\n",
        "print(\"feature columns:\", len(FEATURE_COLUMNS))\n",
        "print(\"binary target columns:\", len(BINARY_TARGET_COLUMNS))\n",
        "print(\"regression target columns:\", len(REGRESSION_TARGET_COLUMNS))\n",
        "\n",
        "display(pd.DataFrame({\"feature_columns\": FEATURE_COLUMNS}).head(100))\n",
        "display(pd.DataFrame({\"binary_target_columns\": BINARY_TARGET_COLUMNS}).head(100))\n",
        "display(pd.DataFrame({\"regression_target_columns\": REGRESSION_TARGET_COLUMNS}).head(100))\n",
        "\n",
        "nan_summary = (\n",
        "    df.isna().mean().mul(100).sort_values(ascending=False).rename(\"nan_pct\").reset_index().rename(columns={\"index\": \"column\"})\n",
        ")\n",
        "display(nan_summary.head(30))\n"
      ]
    },
