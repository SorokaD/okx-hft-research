        "# Сборка: scripts/build_features_merged_w3600.py мержит реконструированный стакан + этот таргет → FEATURES_PARQUET.\n",
        "TARGETS_PARQUET = ROOT / \"outputs\" / \"targets\" / \"btc_usdt_swap_targets_dataset_260_550_h30_300.parquet\"\n",
