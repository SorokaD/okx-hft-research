      "source": [
        "# ============================================================\n",
        "# 3. Исследование горизонтов и порогов\n",
        "# ============================================================\n",
        "display(rate_df[[\"target_name\", \"direction\", \"threshold_ticks\", \"adverse_ticks\", \"horizon_sec\", \"symmetric\", \"positive_rate_pct\"]].head(40))\n",
        "\n",
        "fig = plot_target_heatmap(rate_df, direction=\"long\", symmetric=True, title=\"Long symmetric targets: positive rate heatmap\")\n",
        "if fig is not None:\n",
        "    fig.savefig(OUTPUT_DIR / \"heatmap_long_symmetric.png\", dpi=160)\n",
        "    plt.show()\n",
        "\n",
        "fig = plot_target_heatmap(rate_df, direction=\"short\", symmetric=True, title=\"Short symmetric targets: positive rate heatmap\")\n",
        "if fig is not None:\n",
        "    fig.savefig(OUTPUT_DIR / \"heatmap_short_symmetric.png\", dpi=160)\n",
        "    plt.show()\n",
        "\n",
        "fig = plot_target_heatmap(rate_df, direction=\"long\", symmetric=False, title=\"Long asymmetric TP/SL targets: positive rate heatmap\")\n",
        "if fig is not None:\n",
        "    fig.savefig(OUTPUT_DIR / \"heatmap_long_asymmetric.png\", dpi=160)\n",
        "    plt.show()\n",
        "\n",
        "fig = plot_target_heatmap(rate_df, direction=\"short\", symmetric=False, title=\"Short asymmetric TP/SL targets: positive rate heatmap\")\n",
        "if fig is not None:\n",
        "    fig.savefig(OUTPUT_DIR / \"heatmap_short_asymmetric.png\", dpi=160)\n",
        "    plt.show()\n",
        "\n",
        "plotly_df = rate_df.dropna(subset=[\"threshold_ticks\", \"horizon_sec\", \"positive_rate_pct\"]).copy()\n",
        "if not plotly_df.empty:\n",
        "    fig = px.scatter(\n",
        "        plotly_df,\n",
        "        x=\"threshold_ticks\",\n",
        "        y=\"positive_rate_pct\",\n",
        "        color=\"direction\",\n",
        "        symbol=\"target_quality\",\n",
        "        facet_col=\"horizon_sec\",\n",
        "        hover_data=[\"target_name\", \"adverse_ticks\", \"symmetric\"],\n",
        "        title=\"Positive rate по threshold / horizon / direction\",\n",
        "    )\n",
        "    fig.show()\n",
        "\n",
        "rate_pivot_notes = []\n",
        "for direction in [\"long\", \"short\"]:\n",
        "    sub = rate_df[(rate_df[\"direction\"] == direction) & rate_df[\"threshold_ticks\"].notna() & rate_df[\"horizon_sec\"].notna()]\n",
        "    if sub.empty:\n",
        "        continue\n",
        "    lowest = sub.nsmallest(3, \"positive_rate_pct\")[[\"target_name\", \"positive_rate_pct\"]]\n",
        "    highest = sub.nlargest(3, \"positive_rate_pct\")[[\"target_name\", \"positive_rate_pct\"]]\n",
        "    rate_pivot_notes.append({\"direction\": direction, \"rarest\": lowest.to_dict(\"records\"), \"most_common\": highest.to_dict(\"records\")})\n",
        "display(pd.DataFrame(rate_pivot_notes))\n",
        "print(\"Ключевая идея: чем выше threshold и короче horizon, тем ниже positive rate. Именно это надо проверить на heatmap.\")\n"
      ]
    },
