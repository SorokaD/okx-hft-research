        "    \"mark_px\",\n",
        "})\n",
        "MAX_ROWS_FOR_KDE = 200_000\n",
        "MAX_ROWS_FOR_FEATURE_PLOTS = 120_000\n",
        "\n",
        "# Загрузка merged parquet (~7M строк × ~766 колонок): полный датасет в float64 даёт десятки ГБ RAM.\n",
