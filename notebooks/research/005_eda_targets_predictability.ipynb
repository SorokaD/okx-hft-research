        "# 5. MFE / MAE distributions\n",
        "# ============================================================\n",
        "parsed_reg = pd.DataFrame([parse_target_name(col) for col in REGRESSION_TARGET_COLUMNS])\n",
        "display(parsed_reg.head(20))\n",
        "\n",
        "selected_horizons = [h for h in [30, 60, 180] if h in parsed_reg[\"horizon_sec\"].dropna().tolist()]\n",
        "quantile_rows = []\n",
        "for col in REGRESSION_TARGET_COLUMNS:\n",
        "    meta = parse_target_name(col)\n",
        "    if meta[\"horizon_sec\"] not in selected_horizons:\n",
        "        continue\n",
        "    s = pd.to_numeric(df[col], errors=\"coerce\")\n",
        "    quantile_rows.append(\n",
        "        {\n",
        "            \"target_name\": col,\n",
        "            \"median\": s.quantile(0.50),\n",
        "            \"p75\": s.quantile(0.75),\n",
        "            \"p90\": s.quantile(0.90),\n",
        "            \"p95\": s.quantile(0.95),\n",
        "            \"p99\": s.quantile(0.99),\n",
        "            **meta,\n",
        "        }\n",
        "    )\n",
        "quantiles_df = pd.DataFrame(quantile_rows)\n",
        "display(quantiles_df.sort_values([\"direction\", \"excursion_type\", \"horizon_sec\"]))\n",
        "\n",
        "sample_df = df.sample(min(len(df), MAX_ROWS_FOR_KDE), random_state=RANDOM_SEED) if len(df) > MAX_ROWS_FOR_KDE else df.copy()\n",
        "for direction in [\"long\", \"short\"]:\n",
        "    for excursion_type in [\"favorable\", \"adverse\"]:\n",
        "        cols = [\n",
        "            col\n",
        "            for col in REGRESSION_TARGET_COLUMNS\n",
        "            if parse_target_name(col)[\"direction\"] == direction\n",
        "            and parse_target_name(col)[\"excursion_type\"] == excursion_type\n",
        "            and parse_target_name(col)[\"horizon_sec\"] in selected_horizons\n",
        "        ]\n",
        "        if not cols:\n",
        "            continue\n",
        "        fig, axes = plt.subplots(len(cols), 3, figsize=(16, 4 * len(cols)))\n",
        "        axes = np.atleast_2d(axes)\n",
        "        for row_i, col in enumerate(cols):\n",
        "            s = pd.to_numeric(sample_df[col], errors=\"coerce\").dropna()\n",
        "            sns.histplot(s, bins=80, ax=axes[row_i, 0], color=\"steelblue\")\n",
        "            axes[row_i, 0].set_title(f\"Histogram: {col}\")\n",
        "            sns.kdeplot(s, ax=axes[row_i, 1], fill=True, color=\"darkorange\")\n",
        "            axes[row_i, 1].set_title(f\"KDE: {col}\")\n",
        "            sns.boxplot(x=s, ax=axes[row_i, 2], color=\"seagreen\")\n",
        "            axes[row_i, 2].set_title(f\"Boxplot: {col}\")\n",
        "        plt.tight_layout()\n",
        "        plt.show()\n",
        "\n",
        "x_grid = np.arange(0, 501, 10)\n",
        "survival_rows = []\n",
        "for col in REGRESSION_TARGET_COLUMNS:\n",
        "    meta = parse_target_name(col)\n",
        "    if meta[\"excursion_type\"] != \"favorable\" or meta[\"horizon_sec\"] not in selected_horizons:\n",
        "        continue\n",
        "    s = pd.to_numeric(df[col], errors=\"coerce\")\n",
        "    for x in x_grid:\n",
        "        survival_rows.append(\n",
        "            {\n",
        "                \"target_name\": col,\n",
        "                \"direction\": meta[\"direction\"],\n",
        "                \"horizon_sec\": meta[\"horizon_sec\"],\n",
        "                \"ticks\": x,\n",
        "                \"survival_prob\": float((s >= x).mean()),\n",
        "            }\n",
        "        )\n",
        "survival_df = pd.DataFrame(survival_rows)\n",
        "fig, axes = plt.subplots(1, len(selected_horizons), figsize=(6 * len(selected_horizons), 4), sharey=True)\n",
        "axes = np.atleast_1d(axes)\n",
        "for ax, horizon in zip(axes, selected_horizons):\n",
        "    sub = survival_df[survival_df[\"horizon_sec\"] == horizon]\n",
        "    for direction in sorted(sub[\"direction\"].unique()):\n",
        "        ssub = sub[sub[\"direction\"] == direction]\n",
        "        ax.plot(ssub[\"ticks\"], ssub[\"survival_prob\"], label=direction)\n",
        "    ax.set_title(f\"P(MFE >= X ticks), horizon={horizon}s\")\n",
        "    ax.set_xlabel(\"ticks\")\n",
        "    ax.set_ylabel(\"probability\")\n",
        "    ax.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "important_tick_check = []\n",
        "for horizon in selected_horizons:\n",
        "    cols = [c for c in REGRESSION_TARGET_COLUMNS if f\"within_{horizon}s\" in c and \"favorable\" in c]\n",
        "    for col in cols:\n",
        "        s = pd.to_numeric(df[col], errors=\"coerce\")\n",
        "        important_tick_check.append({\"target_name\": col, \"share_ge_260\": float((s >= 260).mean()), \"share_ge_300\": float((s >= 300).mean())})\n",
        "display(pd.DataFrame(important_tick_check).sort_values(\"share_ge_260\", ascending=False))\n"
      ]
    },
