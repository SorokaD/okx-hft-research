        "OUTPUT_DIR = ROOT / \"outputs\" / \"eda_targets_predictability\"\n",
        "OUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "# Ограничения для тяжёлых секций notebook.\n",
        "MAX_COMPARE_FEATURES = 20\n",
        "MAX_MODEL_FEATURES = 30\n",
        "MAX_TARGETS_FOR_MODELING = 18\n",
        "# Бинарные таргеты для baseline / stability: favorable threshold (ticks) >= этого порога.\n",
        "MODEL_MIN_FAVORABLE_TICKS = 260\n",
        "# Сырые уровни котировки (абсолютные цены) не подаём в обучение baseline / stability.\n",
        "MODEL_EXCLUDE_RAW_PRICE_FEATURES = frozenset({\n",
        "    \"mid_px\",\n",
        "    \"spread_px\",\n",
        "    \"bid_px\",\n",
        "    \"ask_px\",\n",
